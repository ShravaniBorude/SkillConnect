# Environment Configuration Template
# Copy to .env (never commit real secrets)

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillconnect
DB_USERNAME=root
DB_PASSWORD=changeme

# Backend Server & Security
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-at-least-64-character-random-base64-or-hex-secret-key-for-hs256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# Email (SMTP) - Leave MAIL_HOST blank in dev to log verification links safely to console
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@skillconnect.local

# Razorpay (Test Mode Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PLATFORM_FEE_PERCENT=10.0

# Cloudinary (Leave blank in dev to use validated local uploads directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR=./uploads

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
VITE_RAZORPAY_KEY_ID=
